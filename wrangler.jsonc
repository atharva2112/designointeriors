{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "designointeriors",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "workers_dev": true,
  "preview_urls": true,
  "observability": { "enabled": true }
}
